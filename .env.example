# Public origin of the deployed site (e.g. https://adriano.dev). Used for canonical URLs
# and absolute Open Graph URLs. Leave empty locally; falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only on the production deployment. Anything else emits robots noindex.
NEXT_PUBLIC_ALLOW_INDEXING=

# Commit the build was made from. CI sets it (Vercel and Docker builds); the footer then
# shows "Version <sha7>" linked to the commit. Leave empty locally.
COMMIT_SHA=
